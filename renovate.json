{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "qopsc/oarlock-website: update PRs only; a merge builds a tested candidate image, production changes only when qopsc/stacks promotes its digest.",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "automerge": false,
  "platformAutomerge": false,
  "pinDigests": true,
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "labels": ["deps"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "minimumReleaseAge": "3 days", "addLabels": ["security"] },
  "enabledManagers": ["bun", "dockerfile", "github-actions"],
  "ignorePaths": ["docs/**", "dist/**"],
  "packageRules": [
    {
      "description": "Majors wait for approval on the dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["needs-plan"]
    },
    {
      "description": "Astro, Starlight and the @astrojs/* integrations move together",
      "matchManagers": ["bun"],
      "matchPackageNames": ["astro", "@astrojs/starlight", "/^@astrojs//"],
      "groupName": "astro"
    }
  ]
}
