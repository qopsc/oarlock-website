---
/**
 * Animated hero background: machines (squares) and agents (dots) drifting on a
 * network, with packets travelling between them. Decorative only. Draws one
 * still frame with reduced motion, and pauses when offscreen or in a background tab.
 */
---

<canvas class="network" data-network aria-hidden="true"></canvas>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; host: boolean; pulse: number };
  type Packet = { from: Node; to: Node; t: number; speed: number };

  const canvas = document.querySelector<HTMLCanvasElement>("[data-network]");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const LINK = 170; // max distance for a connection, in CSS pixels
    let width = 0;
    let height = 0;
    let nodes: Node[] = [];
    let packets: Packet[] = [];
    let pointer: { x: number; y: number } | null = null;
    let accent = "#51d0ae";
    let ink = "#e6efeb";

    const readColors = () => {
      const style = getComputedStyle(document.documentElement);
      accent = style.getPropertyValue("--accent").trim() || accent;
      ink = style.getPropertyValue("--text").trim() || ink;
    };

    const rgba = (hex: string, alpha: number) => {
      const n = parseInt(hex.slice(1), 16);
      return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(80, Math.round((width * height) / 16000));
      nodes = Array.from({ length: count }, (_, i) => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.18,
        vy: (Math.random() - 0.5) * 0.18,
        host: i % 7 === 0,
        pulse: 0,
      }));
      packets = [];
    };

    const neighbours = (a: Node) => nodes.filter((b) => b !== a && Math.hypot(a.x - b.x, a.y - b.y) < LINK);

    const spawnPacket = () => {
      const from = nodes[Math.floor(Math.random() * nodes.length)];
      const near = neighbours(from);
      if (!near.length) return;
      const to = near[Math.floor(Math.random() * near.length)];
      packets.push({ from, to, t: 0, speed: 0.008 + Math.random() * 0.012 });
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx.strokeStyle = rgba(accent, 0.24 * (1 - d / LINK));
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        if (pointer) {
          const d = Math.hypot(a.x - pointer.x, a.y - pointer.y);
          if (d < LINK * 1.2) {
            ctx.strokeStyle = rgba(accent, 0.35 * (1 - d / (LINK * 1.2)));
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.stroke();
          }
        }
      }

      for (const n of nodes) {
        if (n.pulse > 0) {
          ctx.strokeStyle = rgba(accent, n.pulse * 0.6);
          ctx.beginPath();
          ctx.arc(n.x, n.y, 4 + (1 - n.pulse) * 14, 0, Math.PI * 2);
          ctx.stroke();
        }
        if (n.host) {
          ctx.fillStyle = rgba(ink, 0.22);
          ctx.strokeStyle = rgba(accent, 0.55);
          ctx.beginPath();
          ctx.roundRect(n.x - 4.5, n.y - 4.5, 9, 9, 2);
          ctx.fill();
          ctx.stroke();
        } else {
          ctx.fillStyle = rgba(accent, 0.6);
          ctx.beginPath();
          ctx.arc(n.x, n.y, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      for (const p of packets) {
        const x = p.from.x + (p.to.x - p.from.x) * p.t;
        const y = p.from.y + (p.to.y - p.from.y) * p.t;
        const tail = Math.max(0, p.t - 0.18);
        const gradient = ctx.createLinearGradient(
          p.from.x + (p.to.x - p.from.x) * tail,
          p.from.y + (p.to.y - p.from.y) * tail,
          x,
          y,
        );
        gradient.addColorStop(0, rgba(accent, 0));
        gradient.addColorStop(1, rgba(accent, 0.9));
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(p.from.x + (p.to.x - p.from.x) * tail, p.from.y + (p.to.y - p.from.y) * tail);
        ctx.lineTo(x, y);
        ctx.stroke();
        ctx.fillStyle = rgba(accent, 1);
        ctx.beginPath();
        ctx.arc(x, y, 2, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const step = () => {
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -20) n.x = width + 20;
        if (n.x > width + 20) n.x = -20;
        if (n.y < -20) n.y = height + 20;
        if (n.y > height + 20) n.y = -20;
        n.pulse = Math.max(0, n.pulse - 0.02);
      }
      for (const p of packets) p.t += p.speed;
      for (const p of packets) if (p.t >= 1) p.to.pulse = 1;
      packets = packets.filter((p) => p.t < 1);
      if (packets.length < nodes.length / 3 && Math.random() < 0.12) spawnPacket();
    };

    let running = false;
    let visible = true;
    const loop = () => {
      if (!visible || document.hidden) {
        running = false;
        return;
      }
      step();
      draw();
      requestAnimationFrame(loop);
    };
    const start = () => {
      if (reduced || running) return;
      running = true;
      requestAnimationFrame(loop);
    };

    readColors();
    resize();
    if (reduced) {
      for (let i = 0; i < 6; i++) spawnPacket();
      for (const p of packets) p.t = 0.5;
      draw();
    } else {
      start();
    }

    new ResizeObserver(() => {
      resize();
      if (reduced) draw();
    }).observe(canvas);
    new MutationObserver(() => {
      readColors();
      if (reduced) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    }).observe(canvas);
    document.addEventListener("visibilitychange", () => !document.hidden && start());

    const section = canvas.parentElement!;
    section.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    });
    section.addEventListener("pointerleave", () => (pointer = null));
  }
</script>

<style>
  .network {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    /* Fade toward the bottom and keep the area behind the headline calmer. */
    mask-image:
      linear-gradient(to bottom, black 60%, transparent),
      radial-gradient(ellipse 45% 55% at 25% 45%, rgb(0 0 0 / 0.35), black 75%);
    mask-composite: intersect;
  }
</style>
