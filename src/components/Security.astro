---
import { securityPoints } from "../data/security";
import { links } from "../data/site";
---

<section class="section band" id="security">
  <div class="container split">
    <div class="section-head">
      <h2>An agent with a shell needs guardrails.</h2>
      <p class="lead">
        Oarlock runs shells, edits files, and talks to AI providers, so every boundary checks its input before acting.
        Read the <a href="https://github.com/qopsc/oarlock/blob/main/docs/architecture/security-model.md">security model</a>
        or <a href={links.security}>report a vulnerability</a>.
      </p>
    </div>
    <dl>
      {
        securityPoints.map((p) => (
          <div class="row">
            <dt>{p.title}</dt>
            <dd class="muted">{p.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .row {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.375rem;
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  dd {
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: var(--measure);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 2rem;
    }
  }
</style>
