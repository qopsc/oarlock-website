---
import Command from "./Command.astro";
import { platforms, assetUrl, checksumsUrl } from "../data/downloads";
import { site, links } from "../data/site";
---

<section class="section" id="download">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">oarlock install</p>
      <h2>Install Oarlock.</h2>
      <p class="lead">
        One command picks the right build for your machine, verifies its checksum, and puts the <code>oarlock</code> CLI on
        your PATH. Re-run it to update.
      </p>
    </div>

    <div class="methods">
      <div class="card method primary">
        <h3>Install script <span class="tag">macOS · Linux</span></h3>
        <Command command={site.install.unix} />
        <p class="muted small">
          Installs a .dmg on macOS and your distro's .deb or .rpm on Linux (AppImage elsewhere).
          <a href="/install">Read the script</a> · <a href="/docs/install/">Options</a>
        </p>
      </div>
      <div class="card method">
        <h3>Homebrew <span class="tag">macOS</span></h3>
        <Command command={site.install.brew} />
      </div>
      <div class="card method">
        <h3>Nix <span class="tag">Linux</span></h3>
        <Command command={site.install.nix} />
      </div>
      <div class="card method wide">
        <h3>AUR <span class="tag">Arch Linux</span></h3>
        <p class="muted small"><span class="badge">coming soon</span> Until then, the install script uses the AppImage on Arch.</p>
      </div>
    </div>

    <h3 class="direct">Direct downloads</h3>
    <div class="platforms">
      {
        platforms.map((p) => (
          <div class="card platform">
            <p class="name">
              {p.name} {p.status === "soon" && <span class="badge">coming soon</span>}
            </p>
            {p.status === "available" ? (
              <ul>
                {p.assets.map((a) => (
                  <li>
                    <a href={assetUrl(a.file)}>{a.label}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted small">
                Windows builds are on the way. For now, <a href="/docs/build-from-source/">build from source</a>.
              </p>
            )}
          </div>
        ))
      }
    </div>
    <p class="muted small footnote">
      Every release publishes <a href={checksumsUrl}>SHA256SUMS</a>. All versions are on
      <a href={links.releases}>GitHub Releases</a>.
    </p>
  </div>
</section>

<style>
  .methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1rem;
  }

  .method {
    display: grid;
    gap: 0.875rem;
    align-content: start;
    padding: 1.5rem;
  }

  .primary,
  .wide {
    grid-column: 1 / -1;
  }

  .primary {
    border-color: color-mix(in srgb, var(--brass-fill) 55%, var(--line));
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.0625rem;
  }

  .tag {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .small {
    font-size: 0.875rem;
  }

  .direct {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .platform {
    padding: 1.25rem 1.5rem;
  }

  .name {
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .platform ul {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .platform a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .footnote {
    margin-top: 1.25rem;
  }
</style>
