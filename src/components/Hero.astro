---
import Command from "./Command.astro";
import HeroNetwork from "./HeroNetwork.astro";
import HeroTerminal from "./HeroTerminal.astro";
import Tabs from "./Tabs.astro";
import { site } from "../data/site";
---

<section class="hero">
  <div class="stage">
    <HeroNetwork />
    <div class="container layout">
      <div class="head">
        <h1>
          <span>Your terminal.</span>
          <span>Your machines.</span>
          <span>Your agents.</span>
        </h1>
        <p class="lead">{site.description}</p>
      </div>

      <div class="session-slot">
        <HeroTerminal />
      </div>

      <div class="install">
        <Tabs
          label="Install"
          tabs={[
            { id: "unix", label: "macOS & Linux" },
            { id: "brew", label: "Homebrew" },
            { id: "nix", label: "Nix" },
            { id: "windows", label: "Windows" },
          ]}
          detect={{ macos: "unix", linux: "unix", windows: "windows" }}
        >
          <div data-tab-panel="unix">
            <Command command={site.install.unix} />
          </div>
          <div data-tab-panel="brew">
            <Command command={site.install.brew} />
          </div>
          <div data-tab-panel="nix">
            <Command command={site.install.nix} />
          </div>
          <div data-tab-panel="windows">
            <p class="windows">
              <span class="soon">Coming soon.</span> Until then, <a href="/docs/build-from-source/">build from source</a>.
            </p>
          </div>
        </Tabs>
        <div class="ctas">
          <a class="button" href="#download">Download</a>
          <a class="button button--quiet" href={site.repo}>View on GitHub</a>
          <a class="button button--quiet" href="/docs/">Read the docs</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The first screen: fills the window below the header, over the network animation. */
  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  /* Phones: headline and tagline, install, then the terminal. Wide: headline beside the terminal, install centred below. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "head" "install" "term";
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .head {
    grid-area: head;
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }

  .head .lead {
    max-width: 34rem;
  }

  .session-slot {
    grid-area: term;
  }

  /* Each line pulls a little further right, like successive strokes. */
  h1 {
    --stroke: clamp(1.25rem, 0.25rem + 4vw, 4rem);
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 4.75rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    animation: stroke 0.7s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  h1 span:nth-child(2) {
    margin-left: var(--stroke);
    animation-delay: 0.08s;
  }

  h1 span:nth-child(3) {
    margin-left: calc(var(--stroke) * 2);
    animation-delay: 0.16s;
  }

  @keyframes stroke {
    from {
      opacity: 0;
      transform: translateX(-0.4em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1 span {
      animation: none;
    }
  }

  .install {
    grid-area: install;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-content: start;
  }

  .install :global(.tabs) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  /* Four install options: wrap onto two rows on phones instead of scrolling. */
  .install :global(.tablist) {
    flex-wrap: wrap;
  }

  .windows {
    padding: 0.875rem 1rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: "head term" "install install";
      column-gap: 4rem;
      row-gap: clamp(5rem, 13svh - 1rem, 9rem);
      align-items: center;
    }

    .install {
      justify-self: center;
      width: min(100%, 44rem);
      gap: 1.5rem;
    }

    /* The install row is the main call to action, so it runs a size up from the defaults. */
    .install :global(.tabs) {
      gap: 0.75rem;
    }

    .install :global([role="tab"]) {
      padding: 0.625rem 1.125rem;
      font-size: 1.0625rem;
    }

    .install :global(.command) {
      padding: 0.75rem 0.75rem 0.75rem 1.375rem;
    }

    .install :global(.command code) {
      font-size: 1.0625rem;
    }

    .install .button {
      min-height: 3.25rem;
      padding: 0.75rem 1.625rem;
      font-size: 1.0625rem;
    }

    .ctas {
      gap: 1rem;
    }

    .install :global(.tablist),
    .ctas {
      justify-content: center;
    }
  }
</style>
