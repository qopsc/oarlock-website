---
/**
 * Accessible tabs. Without JS every panel shows, stacked; with JS only the
 * selected one does. Panels are slotted elements with data-tab-panel={id}.
 */
interface Props {
  label: string;
  /** `detail` adds a second line of text under the tab's label. */
  tabs: { id: string; label: string; detail?: string }[];
  /** Stack the tabs in a column, navigated with the up and down arrows. */
  vertical?: boolean;
  /** Open the tab for the visitor's OS first, e.g. { macos: "mac", linux: "linux", windows: "win" }. */
  detect?: Partial<Record<"macos" | "linux" | "windows", string>>;
  class?: string;
}

const { label, tabs, vertical = false, detect, class: className } = Astro.props;
const uid = `tabs-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<div class:list={["tabs", className, { vertical }]} data-tabs={uid} data-detect={detect && JSON.stringify(detect)}>
  <div class="tablist" role="tablist" aria-label={label} aria-orientation={vertical ? "vertical" : undefined} hidden>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-${tab.id}-tab`}
          aria-controls={`${uid}-${tab.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
          aria-labelledby={tab.detail ? `${uid}-${tab.id}-label` : undefined}
          aria-describedby={tab.detail ? `${uid}-${tab.id}-detail` : undefined}
        >
          {tab.detail ? <span class="label" id={`${uid}-${tab.id}-label`}>{tab.label}</span> : tab.label}
          {tab.detail && (
            <span class="detail" id={`${uid}-${tab.id}-detail`}>
              {tab.detail}
            </span>
          )}
        </button>
      ))
    }
  </div>
  <slot />
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const uid = root.dataset.tabs;
    const vertical = root.classList.contains("vertical");
    const list = root.querySelector<HTMLElement>("[role=tablist]");
    if (!list) continue;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = tabs.map((tab) => {
      const panel = root.querySelector<HTMLElement>(`[data-tab-panel="${tab.dataset.tab}"]`);
      panel?.setAttribute("id", `${uid}-${tab.dataset.tab}`);
      panel?.setAttribute("role", "tabpanel");
      panel?.setAttribute("aria-labelledby", tab.id);
      return panel;
    });

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    // Best guess at the visitor's OS; anything unrecognised keeps the first tab.
    const detect = JSON.parse(root.dataset.detect ?? "{}") as Record<string, string>;
    const ua = navigator.userAgent;
    const os = /Windows/.test(ua) ? "windows" : /Mac OS X|Macintosh/.test(ua) && !/iPhone|iPad/.test(ua) ? "macos" : /Linux|X11/.test(ua) && !/Android/.test(ua) ? "linux" : "";
    const initial = tabs.findIndex((tab) => tab.dataset.tab === detect[os]);

    list.hidden = false;
    select(Math.max(initial, 0));
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const forward = vertical ? "ArrowDown" : "ArrowRight";
        const back = vertical ? "ArrowUp" : "ArrowLeft";
        const next =
          event.key === forward ? (i === last ? 0 : i + 1)
          : event.key === back ? (i === 0 ? last : i - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : -1;
        if (next < 0) return;
        event.preventDefault();
        select(next, true);
      });
    });
  }
</script>

<style>
  .tablist {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tablist[hidden] {
    display: none;
  }

  [role="tab"] {
    flex: none;
    padding: 0.5rem 0.875rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  [role="tab"]:hover {
    color: var(--text);
  }

  [role="tab"][aria-selected="true"] {
    color: var(--text);
    border-color: var(--line);
    background: var(--surface-2);
  }

  .vertical .tablist {
    flex-direction: column;
    gap: 0;
    overflow: visible;
  }

  .vertical [role="tab"] {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 0;
    border-left: 2px solid var(--line);
    border-radius: 0;
    text-align: left;
  }

  .vertical [role="tab"][aria-selected="true"] {
    border-left-color: var(--accent);
    background: var(--surface);
  }

  .label {
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .detail {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
