---
import { Image } from "astro:assets";
import Tabs from "./Tabs.astro";
import WindowFrame from "./WindowFrame.astro";
import { features, pillars } from "../data/features";
---

<section class="section" id="features">
  <div class="container">
    <div class="intro">
      <div class="section-head">
        <h2>Everything around the prompt, nothing in the way.</h2>
        <p class="lead">
          A terminal, an agent, an editor, git, and a browser tab, in one lightweight native app built on Tauri and Rust.
        </p>
      </div>
      <dl class="principles">
        {
          pillars.map((p) => (
            <div>
              <dt>{p.title}</dt>
              <dd class="muted">{p.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <Tabs
      label="Features"
      vertical
      tabs={features.map((f) => ({ id: f.id, label: f.title, detail: f.summary }))}
      class="showcase"
    >
      {
        features.map((f) => (
          <div class="panel" data-tab-panel={f.id}>
            <WindowFrame bare>
              <Image src={f.screen} alt={f.alt} widths={[640, 960, 1400]} sizes="(min-width: 64rem) 50rem, 100vw" />
            </WindowFrame>
            <div class="copy">
              <h3>{f.title}</h3>
              <p class="summary muted">{f.summary}</p>
              <ul>
                {f.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </Tabs>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .intro .section-head {
    margin-bottom: 0;
  }

  /* What Oarlock stands for, as a compact two-column list. */
  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem 2rem;
  }

  .principles div {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .principles dt {
    font-weight: 600;
  }

  .principles dd {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }

    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd one out takes the full row instead of sitting alone. */
    .principles div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .section :global(.showcase) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .panel {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  /* Without JS every panel shows, stacked. */
  .panel + .panel {
    margin-top: 4rem;
  }

  .panel[role="tabpanel"] {
    margin-top: 0;
  }

  /* With JS the tab already shows the title and summary. */
  .panel[role="tabpanel"] h3,
  .panel[role="tabpanel"] .summary {
    display: none;
  }

  .copy {
    display: grid;
    gap: 0.75rem;
  }

  .copy ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem 2rem;
    padding: 0;
    list-style: none;
  }

  .copy li {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Narrow screens: a scrolling row of titles above the screenshot. */
  @media (max-width: 63.99rem) {
    .section :global(.showcase .tablist) {
      flex-direction: row;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .section :global(.showcase [role="tab"]) {
      flex: none;
      padding: 0.625rem 1rem;
      border-left: 0;
      border-bottom: 2px solid var(--line);
    }

    .section :global(.showcase [role="tab"][aria-selected="true"]) {
      border-bottom-color: var(--accent);
      background: transparent;
    }

    .section :global(.showcase .detail) {
      display: none;
    }

    .panel[role="tabpanel"] .summary {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .section :global(.showcase) {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 3rem;
      align-items: start;
    }

    .panel {
      grid-column: 1 / -1;
    }

    .panel[role="tabpanel"] {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
