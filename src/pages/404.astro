---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">cd ..</p>
      <h1>No such file or directory.</h1>
      <p class="lead">The page you're looking for isn't here. Try the <a href="/">home page</a> or the <a href="/docs/">docs</a>.</p>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-block: 1rem;
    font-size: var(--step-3);
  }
</style>
